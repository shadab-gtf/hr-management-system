# Server-side backend connection; never put database/service credentials here.
GTF_API_MODE=live
GTF_API_BASE_URL=http://127.0.0.1:4000
GTF_API_TIMEOUT_MS=15000
GTF_SESSION_COOKIE=gtf-session
# Production Vercel mock demo requires BOTH GTF_DEMO_MODE=true and GTF_API_MODE=mock.
# Never enable this for an HR deployment containing real employee data.
GTF_DEMO_MODE=false
