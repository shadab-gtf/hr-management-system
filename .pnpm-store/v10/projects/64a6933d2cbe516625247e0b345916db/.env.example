NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://hr_api_dev:replace_local_password@localhost:5433/hr_api_dev?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=https://your-identity-provider.example
JWT_AUDIENCE=gtf-hr-api
# Optional: debug | info | warn | error (default depends on NODE_ENV)
# LOG_LEVEL=info
POSTGRES_PASSWORD=replace_local_password
APP_BASE_URL=http://127.0.0.1:3000
STORAGE_DIR=./storage
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Without SMTP, messages remain queued. Secrets and email bodies are never logged.
MAIL_FROM=GTF HR <no-reply@gtf-hr.example>
# Required in production: 32 random bytes encoded as 64 hexadecimal characters.
# Keep this key stable and back it up securely; it encrypts MFA, phone, PAN and bank data.
# ENCRYPTION_KEY=
MFA_ENFORCED=true
BACKGROUND_JOBS_ENABLED=true
# HTTP SMS adapter: POST { to, message }, optional Authorization: Bearer token.
# SMS_GATEWAY_URL=https://your-sms-adapter.example/send
# SMS_GATEWAY_TOKEN=
# Scanner adapter: POST raw bytes; JSON response { "clean": true | false }.
# Missing/unavailable scanner keeps documents quarantined.
# FILE_SCANNER_URL=https://your-scanner-adapter.example/scan
# FILE_SCANNER_TOKEN=
# Selfie + GPS attendance (docs/api/attendance-log.md).
# Worst accepted GPS accuracy radius in metres (10-1000).
ATTENDANCE_LOG_MAX_ACCURACY_M=100
# flag (default): accept a log from a new device, flag it and notify HR. reject: refuse unregistered devices.
ATTENDANCE_LOG_NEW_DEVICE_POLICY=flag
# flag (default): accept and flag a log outside every office geofence. reject: refuse it (remote-allowed days excepted).
ATTENDANCE_LOG_OUTSIDE_GEOFENCE_POLICY=flag
# Days selfies are kept; the background job then deletes the image (the append-only log row is kept).
ATTENDANCE_SELFIE_RETENTION_DAYS=90
# Development seed only: password given to every seeded demo account (15+ characters).
DEV_SEED_PASSWORD=replace_with_a_long_local_only_passphrase
