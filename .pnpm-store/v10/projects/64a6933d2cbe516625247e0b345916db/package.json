{
  "name": "gtfhrbackend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:api": "tsx scripts/audit-frontend-routes.ts",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:dev": "tsx prisma/seed.ts",
    "bootstrap:hr": "tsx scripts/bootstrap-hr.ts",
    "bootstrap:organization": "tsx scripts/bootstrap-organization.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup-local": "tsx scripts/setup-local-db.ts",
    "db:sandbox": "tsx scripts/db-sandbox.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "jose": "6.1.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "read-excel-file": "5.8.8",
    "ws": "^8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  }
}
